# Add inside the samsarukhanyan.com server block (port 443) on the portfolio server.
# Incident Lab Control Plane listens on 127.0.0.1:3100 (server/src/lab, systemd unit later).

location /api/ {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Overwrite, never append: the Control Plane trusts this for per-IP limits.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    client_max_body_size 4k;
}

# Live event stream: no buffering, long-lived.
location = /api/events {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 1h;
}
