# /etc/nginx/sites-available/lab on the portfolio server.
# lab.samsarukhanyan.com -> Incident Lab sandbox over the private network.
# Replace LAB_PRIVATE_IP with `terraform output -raw lab_private_ip`, then:
#   sudo ln -sf /etc/nginx/sites-available/lab /etc/nginx/sites-enabled/lab
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d lab.samsarukhanyan.com

server {
    listen 80;
    listen [::]:80;
    server_name lab.samsarukhanyan.com;

    location / {
        proxy_pass http://LAB_PRIVATE_IP;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;

        # Sandbox asleep or broken on purpose: a live status page instead of a bare 502.
        proxy_intercept_errors off;
        error_page 502 503 504 =503 @lab_down;
    }

    location @lab_down {
        default_type text/html;
        add_header Cache-Control "no-store" always;
        # Live status page that polls until the lab is back (written by infra/control-plane.sh.tftpl).
        root /var/www/lab-down;
        rewrite ^ /index.html break;
    }
}
