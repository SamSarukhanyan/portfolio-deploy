#!/bin/bash
# Install or update the Incident Lab Control Plane on the portfolio server (idempotent).
# Layout: /opt/incident-lab/releases/<sha>/server/{package.json,node_modules,dist-lab}
#         current -> releases/<sha>; data in /var/lib/incident-lab; systemd unit incident-lab.
set -euo pipefail

RELEASE='{{ Release }}'
URL='{{ ArtifactUrl }}'
APP=/opt/incident-lab
DATA=/var/lib/incident-lab
DIR="$APP/releases/$RELEASE"

# --- one-time setup ---
command -v node >/dev/null || { apt-get update -q; DEBIAN_FRONTEND=noninteractive apt-get install -y -q nodejs; }
id incidentlab >/dev/null 2>&1 || useradd --system --home-dir "$DATA" --shell /usr/sbin/nologin incidentlab
install -d -o incidentlab -g incidentlab -m 750 "$DATA"
install -d -m 755 "$APP/releases"
# 1 GB RAM is tight for nginx + Node + the SSM agent; swap absorbs spikes instead of the OOM killer.
if [ ! -f /swapfile ]; then
  fallocate -l 1G /swapfile && chmod 600 /swapfile && mkswap -q /swapfile && swapon /swapfile
  grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# --- release ---
if [ ! -f "$DIR/server/dist-lab/server/src/lab/main.js" ]; then
  tmp=$(mktemp -d "$APP/releases/.incoming.XXXXXX")
  trap 'rm -rf "$tmp"' EXIT
  curl -fsS --retry 3 --max-time 180 "$URL" | tar -xz -C "$tmp"
  test -f "$tmp/server/dist-lab/server/src/lab/main.js" || { echo "artifact has no main.js" >&2; exit 1; }
  chmod -R go-w "$tmp" && chmod 755 "$tmp"
  rm -rf "$DIR"
  mv "$tmp" "$DIR"
  trap - EXIT
fi
previous=$(readlink "$APP/current" 2>/dev/null || true)
ln -sfn "releases/$RELEASE" "$APP/current.next" && mv -T "$APP/current.next" "$APP/current"

cat > /etc/systemd/system/incident-lab.service <<'UNIT'
[Unit]
Description=Incident Lab Control Plane
After=network-online.target
Wants=network-online.target

[Service]
User=incidentlab
WorkingDirectory=/opt/incident-lab/current/server
ExecStart=/usr/bin/node dist-lab/server/src/lab/main.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=AWS_REGION=${region}
Environment=LAB_INSTANCE_ID=${lab_instance_id}
Environment=LAB_URL=http://${lab_private_ip}
Environment=LAB_DATA_DIR=/var/lib/incident-lab
Environment=AGENT=claude
Environment=ANTHROPIC_API_KEY_PARAM=${api_key_param}
# Least privilege for a process that talks to the internet.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/incident-lab
MemoryMax=300M

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable -q incident-lab
systemctl restart incident-lab

ok=""
for _ in $(seq 30); do
  curl -fsS --max-time 2 http://127.0.0.1:3100/api/lab/status >/dev/null 2>&1 && { ok=1; break; }
  sleep 1
done
if [ -z "$ok" ]; then
  journalctl -u incident-lab -n 30 --no-pager -o cat >&2
  if [ -n "$previous" ]; then
    ln -sfn "$previous" "$APP/current.next" && mv -T "$APP/current.next" "$APP/current"
    systemctl restart incident-lab
    echo "new release failed to start; rolled back to $previous" >&2
  fi
  exit 1
fi
echo "control plane live: $RELEASE"

# --- nginx: /api -> 127.0.0.1:3100 (docs/nginx-api.conf.example) ---
cat > /etc/nginx/snippets/incident-lab-api.conf <<'NGINX'
location /api/ {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;  # overwrite: per-IP limits trust it
    proxy_set_header Connection "";
    client_max_body_size 4k;
}
location = /api/events {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 1h;
}
NGINX
SITE=/etc/nginx/sites-available/portfolio
if ! grep -q 'snippets/incident-lab-api.conf' "$SITE"; then
  cp "$SITE" "$SITE.before-incident-lab"
  # Into the HTTPS server block only: right before its first "location / {".
  awk '!done && /^[[:space:]]*location \/ \{/ { print "    include snippets/incident-lab-api.conf;\n"; done=1 } { print }' \
    "$SITE.before-incident-lab" > "$SITE"
fi
if nginx -t 2>/dev/null; then
  systemctl reload nginx
else
  nginx -t >&2 || true
  [ -f "$SITE.before-incident-lab" ] && cp "$SITE.before-incident-lab" "$SITE" && systemctl reload nginx
  echo "nginx rejected the /api include; restored the previous config" >&2
  exit 1
fi
echo "nginx: /api -> control plane"

# --- lab.samsarukhanyan.com while the lab is down or asleep: a live status page, not a bare 503 ---
# It polls / every 2 s and, once the lab answers again, opens it with ?recovered=<seconds>.
install -d -m 755 /var/www/lab-down
cat > /var/www/lab-down/index.html <<'HTML'
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="lab-down" content="1"><title>🔴 Incident Lab sandbox</title>
<style>
  body { margin:0; min-height:100vh; display:grid; place-items:center; padding:24px 16px; box-sizing:border-box;
         background:radial-gradient(1200px 600px at 50% -10%, #1a1d24 0%, #0a0b0d 60%); color:#eef0f3;
         font:15px/1.5 Inter,"Segoe UI",Roboto,system-ui,sans-serif; }
  main { width:min(720px,100%) }
  .top { display:flex; align-items:center; gap:10px; margin-bottom:18px; font-weight:650 }
  .logo { width:26px; height:26px; border-radius:8px; background:linear-gradient(135deg,#f5c542,#ff9d3d); display:grid; place-items:center; color:#111; font-weight:800; font-size:13px }
  .card { background:#13151a; border:1px solid #23262d; border-radius:20px; padding:28px; display:flex; align-items:center; gap:22px; box-shadow:0 30px 60px rgba(0,0,0,.35) }
  .orb { flex:none; width:84px; height:84px; border-radius:50%; background:#ff5d5d; position:relative }
  .orb::after { content:""; position:absolute; inset:-10px; border-radius:50%; border:2px solid #ff5d5d; animation:ring 1.8s ease-out infinite }
  @keyframes ring { from { transform:scale(.85); opacity:.5 } to { transform:scale(1.25); opacity:0 } }
  .state { font-size:clamp(28px,7vw,44px); font-weight:800; color:#ff5d5d; line-height:1.05 }
  .detail { margin-top:6px; color:#8b919c }
  .foot { margin-top:18px; color:#8b919c; font-size:13px; text-align:center }
  .foot a { color:#f5c542; text-decoration:none }
  @media (max-width:520px) { .card { flex-direction:column; text-align:center } }
  @media (prefers-reduced-motion:reduce) { .orb::after { animation:none } }
</style></head>
<body><main>
  <div class="top"><span class="logo">IL</span>Incident Lab sandbox</div>
  <section class="card" aria-live="polite"><div class="orb" aria-hidden="true"></div>
    <div><div class="state">Down</div><div class="detail" id="detail">The lab server does not answer. Either an incident is in progress or the server is asleep.</div></div></section>
  <p class="foot">An AI on-call engineer repairs this server. Watch it live on <a href="https://samsarukhanyan.com/lab">samsarukhanyan.com/lab</a>.</p>
</main>
<script>
(() => {
  const started = Date.now();
  setInterval(async () => {
    const secs = Math.round((Date.now() - started) / 1000);
    document.getElementById("detail").textContent = "The lab server does not answer. Down for at least " + secs + " s. Checking every 2 s.";
    try {
      const r = await fetch("/", { cache: "no-store" });
      if (r.ok && !(await r.text()).includes('name="lab-down"')) location.replace("/?recovered=" + secs);
    } catch {}
  }, 2000);
})();
</script>
</body></html>
HTML
LAB_SITE=/etc/nginx/sites-available/lab
if [ -f "$LAB_SITE" ] && grep -q "return 503 '<!doctype" "$LAB_SITE"; then
  cp "$LAB_SITE" "$LAB_SITE.before-down-page"
  # Keep the 503 status (the page polls for it) and serve the file instead of the inline text.
  sed -i -e 's|error_page 502 503 504 = @lab_down;|error_page 502 503 504 =503 @lab_down;|' \
         -e "s|^\([[:space:]]*\)return 503 '<!doctype.*';|\1root /var/www/lab-down;\n\1rewrite ^ /index.html break;|" "$LAB_SITE"
  if nginx -t 2>/dev/null; then systemctl reload nginx; echo "nginx: lab down page installed"
  else cp "$LAB_SITE.before-down-page" "$LAB_SITE"; systemctl reload nginx; echo "nginx rejected the lab down page; restored" >&2; exit 1; fi
fi

# Keep the 3 newest releases; never the live one.
cd "$APP/releases"
{ ls -1t | grep -vx "$RELEASE" || true; } | tail -n +3 | xargs -r rm -rf --
